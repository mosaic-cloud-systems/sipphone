# Copy to .env.local and fill in. Vite builds every VITE_* value into the page's
# JavaScript, so never put the SIP password here; type it into the sign-in dialog.

# Your Wazo stack. The phone connects to wss://<host>/api/asterisk/ws and uses
# <host> as the SIP domain unless the overrides below are set.
VITE_WAZO_HOST=wazo.example.com

# Optional overrides
# VITE_SIP_WS_URL=wss://wazo.example.com/api/asterisk/ws
# VITE_SIP_DOMAIN=wazo.example.com

# Optional: prefill the username field with the line's SIP username.
# VITE_SIP_USERNAME=

# ICE servers, comma-separated. Unset uses Google's public STUN server; set it empty for none.
# VITE_ICE_SERVERS=stun:stun.l.google.com:19302,turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Log every SIP message to the browser console (handy while testing).
# VITE_SIP_TRACE=true
